{
  "name": "dsh-adaptive-tool-router",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that ranks and optionally discloses Top-K tools before each agent step",
  "type": "module",
  "main": "./plugin/src/index.ts",
  "exports": {
    ".": {
      "types": "./plugin/src/index.ts",
      "default": "./plugin/src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/src",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tool-routing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "npm test --prefix plugin",
    "check": "npm run check --prefix plugin"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
